# ─────────────────────────────────────────────────────────────────────────────
# Research Agent — environment
# Copy to `.env` (in this folder). No extra APIs needed: web search and page
# fetching come built in with Claude.
# ─────────────────────────────────────────────────────────────────────────────

# Billing: subscription | credits. Default subscription.
#   subscription: runs on your Claude Pro/Max plan via the Agent SDK, using your
#                 existing `claude login`. Nothing else to set.
#   credits:      pay-as-you-go API credits; needs ANTHROPIC_API_KEY below.
RESEARCH_BILLING=subscription

# Optional, subscription only: for headless/server use where there's no
# `claude login`. Generate with `claude setup-token`.
# CLAUDE_CODE_OAUTH_TOKEN=

# Credits billing only. https://console.anthropic.com
# (Never used by subscription runs: it's stripped from the Agent SDK's env.)
ANTHROPIC_API_KEY=

# Model (optional). Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=claude-opus-5-5

# Refusal fallback (optional). If a safety classifier declines a request (e.g. a
# false positive on a biology or security question), the API re-runs it on this
# model. Credits billing only (subscription runs use Claude Code's own fallback).
# Defaults to claude-opus-4-8. Set to "none" to disable.
ANTHROPIC_FALLBACK_MODEL=claude-opus-4-8

# Effort for the agent loop: low | medium | high | xhigh | max. Default medium.
# medium is plenty for most factual questions and far faster than high on Opus.
# Deep mode bumps this one notch by default.
RESEARCH_EFFORT=medium

# Port for the web UI (npm run serve). Default 3002.
PORT=3002
